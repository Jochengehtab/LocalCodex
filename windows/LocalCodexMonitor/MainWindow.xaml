<Window x:Class="LocalCodexMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Local Codex Monitor" Width="980" Height="700" MinWidth="820" MinHeight="620"
        Background="{DynamicResource WindowBrush}" WindowStartupLocation="CenterScreen">
    <Grid>
        <TabControl x:Name="MainTabs" Margin="12" Background="Transparent" BorderThickness="0">
            <TabItem Header="  DASHBOARD  " Padding="18,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="12">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="22">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="11" Height="11" Fill="{DynamicResource AmberBrush}" Margin="0,5,10,0" VerticalAlignment="Top"/><TextBlock x:Name="StatusText" Text="Verbinde mit Local Codex ..." FontSize="18" FontWeight="SemiBold"/></StackPanel><TextBlock x:Name="ModelText" Text="Ollama wird geprüft" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="21,5,0,0"/></StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="LAUFZEIT" Style="{StaticResource MetricTitle}" HorizontalAlignment="Right"/><TextBlock x:Name="ElapsedText" Text="00:00:00" FontSize="20" FontFamily="Cascadia Mono, Consolas" Margin="0,5,0,0"/></StackPanel>
                            </Grid>
                        </Border>
                        <UniformGrid Grid.Row="1" Columns="4" Margin="-6,8,-6,0">
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="INPUT" Style="{StaticResource MetricTitle}"/><TextBlock x:Name="InputText" Text="-" Style="{StaticResource MetricValue}"/><TextBlock Text="exakt • Ollama Usage" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="OUTPUT" Style="{StaticResource MetricTitle}"/><TextBlock x:Name="OutputText" Text="-" Style="{StaticResource MetricValue}"/><TextBlock x:Name="OutputSourceText" Text="wartet auf Stream" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="GESCHWINDIGKEIT" Style="{StaticResource MetricTitle}"/><TextBlock x:Name="SpeedText" Text="-" Style="{StaticResource MetricValue}"/><TextBlock x:Name="SpeedSourceText" Text="Stream-Messung" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></StackPanel></Border>
                            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="GESPART / TURN" Style="{StaticResource MetricTitle}"/><TextBlock x:Name="CostText" Text="-" Style="{StaticResource MetricValue}"/><TextBlock x:Name="CostModelText" Text="API-Vergleich" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></StackPanel></Border>
                        </UniformGrid>
                        <Grid Grid.Row="2" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,6,6,6"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="115"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="LIVE THROUGHPUT" Style="{StaticResource MetricTitle}"/><Canvas x:Name="SparkCanvas" Grid.Row="1" Margin="0,14,0,6" ClipToBounds="True"><Polyline x:Name="SpeedLine" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3" StrokeLineJoin="Round"/></Canvas><StackPanel Grid.Row="2" Orientation="Horizontal"><TextBlock x:Name="TtftText" Text="TTFT: -" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="TodayText" Text="24h: -" Foreground="{DynamicResource MutedBrush}" Margin="24,0,0,0"/></StackPanel></Grid></Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6"><StackPanel><TextBlock Text="OLLAMA RUNTIME" Style="{StaticResource MetricTitle}"/><TextBlock x:Name="RuntimeModelText" Text="Kein Modell geladen" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,10"/><TextBlock x:Name="RuntimeDetailsText" Text="-" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="23"/><Border Background="{DynamicResource ChipBrush}" CornerRadius="9" Padding="10,5" Margin="0,14,0,0" HorizontalAlignment="Left"><TextBlock x:Name="ContextText" Text="Kontext -" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/></Border></StackPanel></Border>
                        </Grid>
                        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="6,8,6,6"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock Text="DENKZUSAMMENFASSUNG" Style="{StaticResource MetricTitle}"/><TextBlock Text="Keine Rohgedanken • nur sichere Zusammenfassungen" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" FontSize="11"/></DockPanel><TextBox x:Name="ThinkingText" Grid.Row="1" Text="Noch keine Zusammenfassung für diesen Turn." Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" IsReadOnly="True" TextWrapping="Wrap" MinHeight="82" MaxHeight="150" VerticalScrollBarVisibility="Auto" Margin="0,13,0,0"/></Grid></Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="  EINSTELLUNGEN  " Padding="18,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,24" MaxWidth="720">
                    <TextBlock Text="Einstellungen" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Darstellung und Diagnose für deinen lokalen Codex" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,24"/>
                    <Border Style="{StaticResource Card}" Padding="22"><StackPanel><TextBlock Text="DARSTELLUNG" Style="{StaticResource MetricTitle}"/><TextBlock Text="Theme" FontSize="16" FontWeight="SemiBold" Margin="0,13,0,3"/><TextBlock Text="Wähle, ob der Monitor dem Windows-Theme folgen soll." Foreground="{DynamicResource MutedBrush}"/><ComboBox x:Name="ThemeComboBox" Width="250" HorizontalAlignment="Left" Margin="0,14,0,0" SelectionChanged="ThemeComboBox_SelectionChanged"><ComboBoxItem Content="Systemstandard" Tag="system"/><ComboBoxItem Content="Dunkel" Tag="dark"/><ComboBoxItem Content="Hell" Tag="light"/></ComboBox><TextBlock x:Name="ThemeStatusText" Text="Theme wird geladen ..." Foreground="{DynamicResource MutedBrush}" Margin="0,9,0,0"/></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Padding="22"><StackPanel><TextBlock Text="VERBINDUNG" Style="{StaticResource MetricTitle}"/><TextBlock Text="Local Codex Router" FontSize="16" FontWeight="SemiBold" Margin="0,13,0,3"/><TextBlock x:Name="RouterUrlText" Text="-" Foreground="{DynamicResource MutedBrush}" FontFamily="Cascadia Mono, Consolas"/><TextBlock Text="Polling: 250 ms live · Verlauf: 10 s · Daten bleiben lokal" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0"/></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Padding="22"><StackPanel><TextBlock Text="AKTIONEN" Style="{StaticResource MetricTitle}"/><WrapPanel Margin="0,14,0,0"><Button Content="Jetzt aktualisieren" Click="RefreshButton_Click" Margin="0,0,10,8" Padding="16,9"/><Button Content="Log öffnen" Click="OpenLogButton_Click" Margin="0,0,10,8" Padding="16,9"/><Button Content="Monitor beenden" Click="ExitButton_Click" Padding="16,9"/></WrapPanel><TextBlock Text="Local Codex Monitor · Version 1.0 · Ollama-Metriken direkt aus /api/ps und /v1/responses" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                </StackPanel></ScrollViewer>
            </TabItem>
        </TabControl>
        <Border x:Name="OfflineBanner" Background="{DynamicResource DangerBrush}" VerticalAlignment="Bottom" Padding="12" Visibility="Collapsed"><TextBlock x:Name="OfflineText" Text="Router nicht erreichbar – automatischer Reconnect läuft." HorizontalAlignment="Center" FontWeight="SemiBold"/></Border>
    </Grid>
</Window>
